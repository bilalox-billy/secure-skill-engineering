{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DocumentSummarizerOutput",
    "type": "object",
    "oneOf": [
      {
        "required": ["summary", "key_points", "word_count"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 10,
            "maxLength": 1000,
            "description": "Concise document summary"
          },
          "key_points": {
            "type": "array",
            "items": {"type": "string", "minLength": 5},
            "minItems": 1,
            "maxItems": 5,
            "description": "Key factual points from the document"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Word count of original document"
          }
        },
        "additionalProperties": false
      },
      {
        "required": ["error"],
        "properties": {
          "error": {"type": "string"}
        },
        "additionalProperties": false
      }
    ]
  }
  